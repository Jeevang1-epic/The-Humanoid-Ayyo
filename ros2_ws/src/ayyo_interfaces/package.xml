  <description>Message, service, and action contract foundation for the Ayyo robotic system.</description>
  <maintainer email="jeevan116p@gmail.com">P. Jeevan Kumar</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

