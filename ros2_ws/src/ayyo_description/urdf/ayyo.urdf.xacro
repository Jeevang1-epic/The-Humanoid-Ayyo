<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ayyo">
  <xacro:arg name="use_meshes" default="false"/>
  <xacro:arg name="simulation_mode" default="false"/>
  <xacro:arg name="simulation_static" default="true"/>

  <xacro:include filename="ayyo_materials.xacro"/>
  <xacro:include filename="ayyo_geometry.xacro"/>
  <xacro:include filename="ayyo_body.xacro"/>
  <xacro:include filename="ayyo_gazebo.xacro"/>
  <xacro:include filename="ayyo_ros2_control.xacro"/>

  <xacro:ayyo_materials/>
  <xacro:ayyo_body use_meshes="$(arg use_meshes)"/>
  <xacro:if value="$(arg simulation_mode)">
    <xacro:ayyo_gazebo static_model="$(arg simulation_static)"/>
  </xacro:if>
</robot>
