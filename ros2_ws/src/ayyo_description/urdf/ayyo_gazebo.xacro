<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ayyo_gazebo"
               params="static_model control_enabled localization_enabled camera_enabled depth_camera_enabled controller_config manipulation_control_enabled manipulation_support_enabled">
    <xacro:if value="${control_enabled}">
      <xacro:if value="${manipulation_control_enabled}">
        <xacro:if value="${manipulation_support_enabled}">
          <!-- Explicit simulation-only Stage 9C manipulation fixture. The
               articulated model remains dynamic and collisions/gravity remain
               enabled; only its free base is anchored for this bounded proof. -->
          <link name="world"/>
          <joint name="stage9c_manipulation_fixture_joint" type="fixed">
            <parent link="world"/>
            <child link="base_link"/>
          </joint>
        </xacro:if>
      </xacro:if>
    </xacro:if>
    <gazebo reference="imu_link">
      <sensor name="body_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/ayyo/imu/data</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu/>
      </sensor>
    </gazebo>
    <xacro:if value="${camera_enabled}">
      <gazebo reference="head_camera_optical_frame">
        <sensor name="head_rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <topic>/ayyo/camera/head/image_raw</topic>
          <gz_frame_id>head_camera_optical_frame</gz_frame_id>
          <camera>
            <horizontal_fov>1.0471975511965976</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>30.0</far>
            </clip>
            <optical_frame_id>head_camera_optical_frame</optical_frame_id>
            <camera_info_topic>/ayyo/camera/head/camera_info</camera_info_topic>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
    <xacro:if value="${depth_camera_enabled}">
      <gazebo reference="head_depth_camera_optical_frame">
        <sensor name="head_depth_camera" type="depth_camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <topic>/ayyo/camera/head/depth/image_raw</topic>
          <gz_frame_id>head_depth_camera_optical_frame</gz_frame_id>
          <camera>
            <horizontal_fov>1.0471975511965976</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>30.0</far>
            </clip>
            <optical_frame_id>head_depth_camera_optical_frame</optical_frame_id>
            <camera_info_topic>/ayyo/camera/head/depth/camera_info</camera_info_topic>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
    <gazebo>
      <xacro:if value="${localization_enabled}">
        <plugin filename="gz-sim-odometry-publisher-system"
                name="gz::sim::systems::OdometryPublisher">
          <odom_frame>odom</odom_frame>
          <robot_base_frame>base_link</robot_base_frame>
          <dimensions>3</dimensions>
          <odom_publish_frequency>50</odom_publish_frequency>
          <odom_topic>/ayyo/localization/ground_truth/odometry</odom_topic>
        </plugin>
      </xacro:if>
      <xacro:if value="${control_enabled}">
        <static>false</static>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${controller_config}</parameters>
        </plugin>
      </xacro:if>
      <xacro:unless value="${control_enabled}">
        <static>${str(static_model).lower()}</static>
      </xacro:unless>
    </gazebo>
  </xacro:macro>
</robot>
