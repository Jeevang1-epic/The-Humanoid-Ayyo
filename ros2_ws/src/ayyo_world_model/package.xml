<?xml version="1.0"?>
<package format="3">
  <name>ayyo_world_model</name>
  <version>0.1.0</version>
  <description>Lifecycle-managed ROS proprioceptive perception boundary for Ayyo.</description>
  <maintainer email="jeevan116p@gmail.com">P. Jeevan Kumar</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ayyo_interfaces</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
