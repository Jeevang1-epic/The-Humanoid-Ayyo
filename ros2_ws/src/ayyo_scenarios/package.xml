<?xml version="1.0"?>
<package format="3">
  <name>ayyo_scenarios</name>
  <version>0.1.0</version>
  <description>Development-only deterministic Stage-6 scenario orchestration for Ayyo.</description>
  <maintainer email="jeevan116p@gmail.com">P. Jeevan Kumar</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ayyo_description</exec_depend>
  <exec_depend>ayyo_simulation</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
